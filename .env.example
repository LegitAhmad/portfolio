# ------------------------------------------------------------------
# Environment variables — portfolio desktop
#
# Copy to `.env.local` and fill in real values locally.
# Never commit `.env*.local` or any file holding real credentials.
# See docs/architecture.md for how each variable is consumed.
# ------------------------------------------------------------------

# --- Supabase -----------------------------------------------------
# Public (browser-safe) Supabase config. Used by the Supabase client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by route handlers / server actions that need to
# bypass RLS (e.g. admin maintenance). NEVER expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub App ---------------------------------------------------
# Server-only GitHub App credentials for project-sync tooling.
# The private key is a PEM file / its base64 encoding — never ship it
# to the client bundle.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# --- Site ---------------------------------------------------------
# Optional: absolute origin used for metadata / canonical URLs.
# NEXT_PUBLIC_SITE_URL=
