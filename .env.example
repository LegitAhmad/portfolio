# ------------------------------------------------------------------
# Environment variables — portfolio desktop
#
# Copy to `.env.local` and fill in real values locally.
# Never commit `.env*.local` or any file holding real credentials.
# See docs/architecture.md for how each variable is consumed.
# ------------------------------------------------------------------

# --- Supabase -----------------------------------------------------
# Public (browser-safe) Supabase configuration.
# Format: sb_publishable_<random> (New Supabase API standard, replacing legacy anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_key

# Server-only. Used by route handlers, sync workers, and server actions
# that require elevated access. NEVER expose to the client bundle.
# Format: sb_secret_<random> (New Supabase API standard, replacing legacy service_role key)
# SUPABASE_SECRET_KEY=sb_secret_example_key

# --- GitHub App ---------------------------------------------------
# Server-only GitHub App credentials for repository synchronization.
# NEVER prefix these with NEXT_PUBLIC_ or expose them to the client bundle.
# GitHub App ID (Numeric)
GITHUB_APP_ID=
# GitHub App Private Key (.pem content or base64-encoded string)
GITHUB_APP_PRIVATE_KEY=
# GitHub App Installation ID (Numeric ID from installation URL)
GITHUB_APP_INSTALLATION_ID=
# Webhook Secret configured in GitHub App settings (for HMAC verification)
GITHUB_WEBHOOK_SECRET=

# --- Admin CMS -----------------------------------------------------
# Server-only. Used for Admin CMS authentication and role verification.
# ADMIN_EMAIL=owner@example.com
# GITHUB_ADMIN_USERNAME=owner-github-username
# ADMIN_SESSION_SECRET=a-secure-random-32-character-secret-key

# --- Site ---------------------------------------------------------
# Optional: absolute origin used for metadata / canonical URLs.
# Defaults to https://portfolio.local or current request host if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
